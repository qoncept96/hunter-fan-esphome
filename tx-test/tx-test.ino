const int NUM_TRANSITIONS = 155;

void setup() {
  Serial.begin(115200);
  while (!Serial) { delay(50); }
  
  pinMode(TX_PIN, OUTPUT);
  digitalWrite(TX_PIN, LOW);
  
  Serial.println("\n==============================================");
  Serial.println("🏠 Hunter Fan Master Suite Controller Ready");
  Serial.println("Send commands via Serial:");
  Serial.println("  1 -> Light Toggle");
  Serial.println("  2 -> Fan Toggle (On/Off)");
  Serial.println("  3 -> Fan Speed Up");
  Serial.println("  4 -> Fan Speed Down");
  Serial.println("==============================================");
}

void loop() {
  if (Serial.available() > 0) {
    char command = Serial.read();
    
    // Ignore stray carriage returns or newlines
    if (command == '\r' || command == '\n') return;
    
    switch (command) {
      case '1':
        Serial.println("💡 Toggling Light...");
        sendRawArray(LIGHT_TOGGLE);
        break;
      case '2':
        Serial.println("🌀 Toggling Fan Power...");
        sendRawArray(FAN_TOGGLE);
        break;
      case '3':
        Serial.println("🔼 Increasing Fan Speed...");
        sendRawArray(FAN_UP);
        break;
      case '4':
        Serial.println("🔽 Decreasing Fan Speed...");
        sendRawArray(FAN_DOWN);
        break;
      default:
        Serial.println("⚠️ Unknown option. Enter 1, 2, 3, or 4.");
        break;
    }
  }
}

void sendRawArray(const int timingArray[]) {
  // Fire the physical signal 20 times to ensure the canopy decoder catches it
  for (int repeat = 0; repeat < 20; repeat++) {
    bool state = HIGH;
    
    for (int i = 0; i < NUM_TRANSITIONS; i++) {
      digitalWrite(TX_PIN, state);
      delayMicroseconds(timingArray[i]);
      state = !state; 
    }
    
    // Safety guard: drop transmission frame back down to ground
    digitalWrite(TX_PIN, LOW);
    delay(15); 
    
    yield(); 
  }
  Serial.println("Done.");
}